[
  // ---------- PUBLIC ----------
  { "id": "pub-press-release", "label": "Published press release", "example": "\"We are opening a new regional office\"", "categoryId": "public", "difficulty": 1, "explanation": "Press releases are written to be shared with everyone, so they are Public." },
  { "id": "pub-job-ad", "label": "Job advertisement", "example": "\"Junior Analyst - apply by 30 November\"", "categoryId": "public", "difficulty": 1, "explanation": "Job ads are posted openly to attract applicants. That makes them Public." },
  { "id": "pub-brochure", "label": "Marketing brochure", "example": "Glossy leaflet handed out at trade shows", "categoryId": "public", "difficulty": 1, "explanation": "Marketing material is created for outsiders, so it is Public." },
  { "id": "pub-website", "label": "Company website content", "example": "The 'About us' page", "categoryId": "public", "difficulty": 1, "explanation": "Anything already published on the public website is Public." },
  { "id": "pub-main-phone", "label": "Main reception phone number", "example": "+00 1234 567 890 (listed on the website)", "categoryId": "public", "difficulty": 1, "explanation": "A switchboard number that is published for customers is Public." },
  { "id": "pub-annual-report", "label": "Published annual report", "example": "Glossy PDF released to shareholders and the press", "categoryId": "public", "difficulty": 1, "explanation": "Once released publicly, the annual report is Public. The unreleased draft would not be." },
  { "id": "pub-social-post", "label": "Post on the official social media page", "example": "\"Happy holidays from all of us!\"", "categoryId": "public", "difficulty": 1, "explanation": "Social posts on official pages are written for the public." },
  { "id": "pub-catalogue", "label": "Product catalogue with list prices", "example": "Widget A - 19.99", "categoryId": "public", "difficulty": 1, "explanation": "List prices that customers can see are Public. Negotiated supplier prices are a different matter." },
  { "id": "pub-privacy-policy", "label": "Privacy policy", "example": "Link in the website footer", "categoryId": "public", "difficulty": 1, "explanation": "A privacy policy must be available to the people whose data you handle, so it is Public." },
  { "id": "pub-office-address", "label": "Head office address", "example": "1 Example Street, Sampletown", "categoryId": "public", "difficulty": 1, "explanation": "The business address is on the website and letterhead, so it is Public." },
  { "id": "pub-webinar", "label": "Recording of a public webinar", "example": "Open to anyone who registered", "categoryId": "public", "difficulty": 1, "explanation": "Content shared with an open audience is Public." },
  { "id": "pub-agenda", "label": "Conference agenda", "example": "Speaker list for an open event", "categoryId": "public", "difficulty": 1, "explanation": "An agenda for an open event is designed to be shared widely." },
  { "id": "pub-terms", "label": "Terms and conditions", "example": "The terms customers accept when they buy", "categoryId": "public", "difficulty": 1, "explanation": "Customers have to be able to read them, so they are Public." },
  { "id": "pub-manual", "label": "Customer user manual", "example": "PDF download on the support page", "categoryId": "public", "difficulty": 1, "explanation": "Manuals are published for customers, so they are Public." },
  { "id": "pub-faq", "label": "Public FAQ page", "example": "\"How do I reset my account?\"", "categoryId": "public", "difficulty": 1, "explanation": "FAQs exist to inform customers and are Public." },
  { "id": "pub-exec-bio", "label": "Executive biography on the About page", "example": "\"Jane Sample has led the company since 2019\"", "categoryId": "public", "difficulty": 2, "explanation": "The person has agreed to publish it on the website, so it is Public." },
  { "id": "pub-open-source", "label": "Open-source code released on a public repository", "example": "A library anyone can download", "categoryId": "public", "difficulty": 2, "explanation": "Code that has deliberately been published is Public. Private, unreleased code is not." },
  { "id": "pub-contact-mailbox", "label": "Generic contact mailbox shown on the website", "example": "info@example.test", "categoryId": "public", "difficulty": 3, "explanation": "A shared mailbox printed on the website is Public. A list of customer email addresses would be Confidential." },

  // ---------- INTERNAL ----------
  { "id": "int-phone-directory", "label": "Internal phone directory", "example": "Names and extension numbers of all staff", "categoryId": "internal", "difficulty": 1, "explanation": "It is meant for colleagues. Outsiders could use it to target staff, so it is Internal." },
  { "id": "int-intranet-news", "label": "Intranet announcement", "example": "\"The car park is closed on Friday\"", "categoryId": "internal", "difficulty": 1, "explanation": "Everyday staff news is Internal: harmless, but not for the public." },
  { "id": "int-holiday-calendar", "label": "Office holiday calendar", "example": "Closure dates for the year", "categoryId": "internal", "difficulty": 1, "explanation": "Useful to staff, of little value outside. That is Internal." },
  { "id": "int-room-booking", "label": "Meeting room booking schedule", "example": "Room 2B - 10:00 Team sync", "categoryId": "internal", "difficulty": 1, "explanation": "It shows who meets where and when. That is fine internally but not for the public." },
  { "id": "int-org-chart", "label": "Organisation chart", "example": "Who reports to whom", "categoryId": "internal", "difficulty": 1, "explanation": "An org chart helps attackers impersonate managers, so keep it Internal." },
  { "id": "int-newsletter", "label": "Internal staff newsletter", "example": "Monthly roundup for employees", "categoryId": "internal", "difficulty": 1, "explanation": "Written for employees, so it is Internal." },
  { "id": "int-training-slides", "label": "Staff training slides", "example": "Induction deck for new joiners", "categoryId": "internal", "difficulty": 1, "explanation": "General training material for staff is Internal." },
  { "id": "int-leave-policy", "label": "Leave and dress-code policy", "example": "HR handbook chapter", "categoryId": "internal", "difficulty": 1, "explanation": "General workplace policies are for employees, so they are Internal." },
  { "id": "int-helpdesk-guide", "label": "IT helpdesk how-to guide", "example": "\"How to connect to the office printer\"", "categoryId": "internal", "difficulty": 1, "explanation": "Routine instructions for staff, with no secrets in them. That is Internal." },
  { "id": "int-wiki", "label": "Team wiki page", "example": "\"How we run our weekly stand-up\"", "categoryId": "internal", "difficulty": 1, "explanation": "General working knowledge shared inside the company is Internal." },
  { "id": "int-work-email-list", "label": "List of employee work email addresses", "example": "j.sample@example.test, a.demo@example.test", "categoryId": "internal", "difficulty": 2, "explanation": "Work addresses are used to send phishing if the list leaks, so keep it Internal." },
  { "id": "int-project-status", "label": "Routine project status update", "example": "\"Milestone 2 is on track\"", "categoryId": "internal", "difficulty": 2, "explanation": "Ordinary progress updates are for the team and are Internal, provided they contain no financials or client data." },
  { "id": "int-meeting-minutes", "label": "Minutes of a routine team meeting", "example": "Action items and owners", "categoryId": "internal", "difficulty": 2, "explanation": "Normal day-to-day notes are Internal." },
  { "id": "int-floor-plan", "label": "Office floor plan", "example": "Layout of desks, exits and server room", "categoryId": "internal", "difficulty": 2, "explanation": "Floor plans can help someone plan a physical break-in, so they stay inside the company." },
  { "id": "int-draft-marketing", "label": "Draft marketing copy before release", "example": "Version 3 of the campaign text", "categoryId": "internal", "difficulty": 2, "explanation": "Drafts are unfinished and not approved for the public yet. That makes them Internal." },
  { "id": "int-vendor-list", "label": "List of supplier names", "example": "Names only, no prices or contracts", "categoryId": "internal", "difficulty": 2, "explanation": "Just the names is low-risk but not public. The contracts and prices would be Confidential." },
  { "id": "int-survey-summary", "label": "Anonymous staff survey summary", "example": "\"72% would recommend us as an employer\"", "categoryId": "internal", "difficulty": 2, "explanation": "Aggregated, anonymous results are for staff only. They are Internal." },

  // ---------- CONFIDENTIAL ----------
  { "id": "con-customer-list", "label": "Customer mailing list", "example": "Names and email addresses of customers", "categoryId": "confidential", "difficulty": 1, "explanation": "Personal data about customers must be protected. A leak causes real harm and legal trouble." },
  { "id": "con-home-address", "label": "Employee home address", "example": "12 Sample Lane, Testville", "categoryId": "confidential", "difficulty": 1, "explanation": "Personal data about a person, and a safety risk if it falls into the wrong hands." },
  { "id": "con-salary", "label": "Employee salary and bonus data", "example": "Spreadsheet of pay by person", "categoryId": "confidential", "difficulty": 2, "explanation": "Pay details are private to each person and sensitive for the business." },
  { "id": "con-roadmap", "label": "Unreleased product roadmap", "example": "Features planned for next year", "categoryId": "confidential", "difficulty": 2, "explanation": "Competitors could use it and customers could be misled. Confidential until announced." },
  { "id": "con-customer-contract", "label": "Signed customer contract", "example": "Terms, prices and renewal dates", "categoryId": "confidential", "difficulty": 2, "explanation": "Contracts usually carry confidentiality clauses, and leaking one can breach them." },
  { "id": "con-supplier-pricing", "label": "Negotiated supplier pricing", "example": "\"Component X costs 3.10 at 10,000 units\"", "categoryId": "confidential", "difficulty": 2, "explanation": "Rivals or other suppliers could use it against us in negotiation." },
  { "id": "con-source-code", "label": "Proprietary application source code", "example": "The main product repository", "categoryId": "confidential", "difficulty": 2, "explanation": "It is a core company asset and can reveal weaknesses to attackers." },
  { "id": "con-performance-review", "label": "Employee performance review", "example": "Annual rating and manager comments", "categoryId": "confidential", "difficulty": 2, "explanation": "It is personal, private to the employee, the manager and HR." },
  { "id": "con-purchase-history", "label": "Customer purchase history", "example": "Order log linked to customer names", "categoryId": "confidential", "difficulty": 2, "explanation": "It links behaviour to identifiable people, so it is personal data." },
  { "id": "con-dob", "label": "Employee date of birth with name", "example": "A. Demo, 01 Jan 1990", "categoryId": "confidential", "difficulty": 2, "explanation": "A name plus a date of birth is a strong identity-theft starter." },
  { "id": "con-network-diagram", "label": "Network diagram", "example": "Firewalls, subnets and servers", "categoryId": "confidential", "difficulty": 2, "explanation": "It is a map for attackers. Only IT should have it." },
  { "id": "con-cv", "label": "Job candidate CVs", "example": "Applications received for a vacancy", "categoryId": "confidential", "difficulty": 2, "explanation": "They hold personal details of applicants who trusted us with them." },
  { "id": "con-continuity-plan", "label": "Incident response plan", "example": "Who does what during a security incident", "categoryId": "confidential", "difficulty": 2, "explanation": "Attackers can plan around it if they know how we respond." },
  { "id": "con-complaints", "label": "Customer complaint records", "example": "Case notes with customer names", "categoryId": "confidential", "difficulty": 2, "explanation": "They contain personal data and can be embarrassing or legally sensitive." },
  { "id": "con-sales-forecast", "label": "Sales pipeline and forecasts", "example": "Expected deals and revenue next quarter", "categoryId": "confidential", "difficulty": 2, "explanation": "Reveals strategy and future performance to competitors." },
  { "id": "con-offer-letter", "label": "Signed job offer letter", "example": "Salary, start date and benefits", "categoryId": "confidential", "difficulty": 2, "explanation": "It contains private pay and personal details." },
  { "id": "con-audit-report", "label": "Internal audit report", "example": "Findings and weaknesses in our controls", "categoryId": "confidential", "difficulty": 3, "explanation": "It lists our own weaknesses. Useful to regulators, competitors and attackers." },
  { "id": "con-vendor-assessment", "label": "Supplier security assessment results", "example": "Questionnaire and score for a vendor", "categoryId": "confidential", "difficulty": 3, "explanation": "It can reveal both the vendor's and our weaknesses, so it is sensitive business information." },
  { "id": "con-server-inventory", "label": "List of server hostnames and IP addresses", "example": "srv-db-01 - 10.0.0.5", "categoryId": "confidential", "difficulty": 3, "explanation": "It is a target list for attackers. IT-only information." },
  { "id": "con-email-list-context", "label": "Spreadsheet of customer email addresses used for a mailing", "example": "customers_2026.xlsx", "categoryId": "confidential", "difficulty": 3, "explanation": "A shared mailbox on the website is Public, but a list of individuals' addresses is personal data." },

  // ---------- RESTRICTED ----------
  { "id": "res-credit-card", "label": "Credit card number", "example": "4111 1111 1111 1111", "categoryId": "restricted", "difficulty": 1, "explanation": "Payment card data is regulated. A leak leads to fraud and heavy penalties." },
  { "id": "res-password", "label": "Account password", "example": "P@ssw0rd-Demo-1!", "categoryId": "restricted", "difficulty": 1, "explanation": "Passwords give direct access to systems and data. Never share or write them down." },
  { "id": "res-national-id", "label": "National ID / social security number", "example": "000-12-3456", "categoryId": "restricted", "difficulty": 1, "explanation": "It is a permanent identifier used for identity theft, and strictly regulated." },
  { "id": "res-bank-account", "label": "Customer bank account details", "example": "IBAN XX00 0000 0000 0000", "categoryId": "restricted", "difficulty": 1, "explanation": "Financial account data enables fraud and is regulated." },
  { "id": "res-card-cvv", "label": "Card security code (CVV)", "example": "3-digit code on the back of a card", "categoryId": "restricted", "difficulty": 1, "explanation": "Payment rules forbid storing it. It is among the most sensitive of all data." },
  { "id": "res-private-key", "label": "Encryption private key", "example": "-----BEGIN PRIVATE KEY-----", "categoryId": "restricted", "difficulty": 2, "explanation": "Whoever holds the key can decrypt data or impersonate our servers." },
  { "id": "res-api-key", "label": "API key or access token", "example": "sk_live_EXAMPLE1234", "categoryId": "restricted", "difficulty": 2, "explanation": "It works like a password for a service. Leaks of these are a common cause of breaches." },
  { "id": "res-medical", "label": "Employee medical records", "example": "Sick-note details and diagnosis", "categoryId": "restricted", "difficulty": 2, "explanation": "Health data is a special category of personal data with strict legal protection." },
  { "id": "res-passport", "label": "Scan of an employee's passport", "example": "Photo page image, kept for right-to-work checks", "categoryId": "restricted", "difficulty": 2, "explanation": "Identity documents allow identity fraud, so they need the strongest protection." },
  { "id": "res-biometric", "label": "Fingerprint template used for door access", "example": "Stored biometric data", "categoryId": "restricted", "difficulty": 2, "explanation": "You can change a password but never a fingerprint, so the law treats biometrics as highly sensitive." },
  { "id": "res-mfa-recovery", "label": "MFA recovery codes", "example": "Backup codes for a login", "categoryId": "restricted", "difficulty": 2, "explanation": "They bypass the second factor, so they are as sensitive as a password." },
  { "id": "res-payroll-bank", "label": "Payroll file with staff bank details", "example": "Names with account numbers", "categoryId": "restricted", "difficulty": 2, "explanation": "Bank details plus names are ideal for payment fraud." },
  { "id": "res-drivers-licence", "label": "Driver's licence number", "example": "SAMPLE 000000 AB1CD", "categoryId": "restricted", "difficulty": 2, "explanation": "Government-issued ID numbers are used for identity theft." },
  { "id": "res-password-db", "label": "Database of user login credentials", "example": "Usernames and password hashes", "categoryId": "restricted", "difficulty": 3, "explanation": "Even hashed passwords can be cracked, and a leak would expose every account." },
  { "id": "res-merger", "label": "Unannounced merger or acquisition plans", "example": "Draft deal terms with another company", "categoryId": "restricted", "difficulty": 3, "explanation": "Early leaks can move markets and break securities laws. Only a few named people may see it." },
  { "id": "res-financials", "label": "Quarterly results before they are announced", "example": "Draft profit figures", "categoryId": "restricted", "difficulty": 3, "explanation": "Using early results for trading is insider dealing, so access is limited to named people." },
  { "id": "res-legal-advice", "label": "Legal advice from the company's lawyers", "example": "Memo on a pending dispute", "categoryId": "restricted", "difficulty": 3, "explanation": "Legal privilege can be lost if it is shared widely, which may hurt us in court." },
  { "id": "res-pentest", "label": "Penetration test report with open vulnerabilities", "example": "Unpatched findings and how to exploit them", "categoryId": "restricted", "difficulty": 3, "explanation": "It is a step-by-step guide to breaking in until every issue is fixed." },
  { "id": "res-trade-secret", "label": "Trade secret formula or algorithm", "example": "The recipe behind our best-selling product", "categoryId": "restricted", "difficulty": 3, "explanation": "If it leaks, the business loses its edge and the legal protection may disappear." },
  { "id": "res-whistleblower", "label": "Identity of a whistleblower", "example": "Name attached to an ethics report", "categoryId": "restricted", "difficulty": 3, "explanation": "Exposing the person can lead to retaliation, and the law requires their identity to be protected." },
  { "id": "res-hr-investigation", "label": "Ongoing HR investigation file", "example": "Witness statements and evidence", "categoryId": "restricted", "difficulty": 3, "explanation": "It concerns named individuals and unproven claims. Only investigators may see it." },
  { "id": "res-background-check", "label": "Criminal background check result", "example": "Report on a new hire", "categoryId": "restricted", "difficulty": 3, "explanation": "Criminal-record data has special legal protection and should be seen by very few." }
]
