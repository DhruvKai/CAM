<UserControl x:Class="DataSortingGame.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="60,34,60,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock x:Name="Subtitle" FontSize="19" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Width="520" VerticalAlignment="Center" Margin="0,10,0,0">
            <TextBlock Text="Your name" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" MaxLength="60"
                     AutomationProperties.Name="Your name" TextChanged="OnNameChanged" KeyDown="OnFieldKeyDown"/>

            <TextBlock Text="Department (optional)" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="2,14,0,4"/>
            <TextBox x:Name="DeptBox" Style="{StaticResource FieldBox}" MaxLength="60"
                     AutomationProperties.Name="Department" KeyDown="OnFieldKeyDown"/>

            <TextBlock x:Name="AttemptInfo" FontSize="15" Foreground="{StaticResource MutedBrush}" MinHeight="40"
                       Margin="2,12,0,0" TextAlignment="Center" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="PlayButton" Content="Play" Style="{StaticResource PrimaryButton}" Width="200"
                        Click="OnPlay" IsDefault="False" IsEnabled="False"/>
                <Button Content="Leaderboard" Margin="16,0,0,0" Width="180" Click="OnLeaderboard"/>
            </StackPanel>
        </StackPanel>

        <!-- Legend so players can read the category definitions before they start. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="HowTo" FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,0,0,10"/>
            <UniformGrid x:Name="Legend" Grid.Row="1"/>
        </Grid>

        <Button Grid.Row="0" Content="Admin" FontSize="12" Padding="10,3" Opacity="0.4" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,-24,-48,0" Click="OnAdmin" AutomationProperties.Name="Admin"/>
    </Grid>
</UserControl>
