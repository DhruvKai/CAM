<Window x:Class="DataSortingGame.Views.QuizQuestionsEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage quiz questions" Width="1240" Height="820" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Manage quiz questions" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Pick a question on the left, then edit it on the right. Mark the correct option with its radio button."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Question list -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="SEARCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" FontSize="14" Padding="10,8"
                                 TextChanged="OnSearchChanged" AutomationProperties.Name="Search questions"/>
                    </StackPanel>

                    <ListBox x:Name="QuestionList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectQuestion" AutomationProperties.Name="Question list">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#0F172A" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#243449"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="+ Add question" Style="{StaticResource PrimaryButton}" FontSize="14"
                            Padding="14,8" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="OnAddQuestion"/>
                </Grid>
            </Border>

            <!-- Detail editor -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText"
                               Text="No question selected. Click '+ Add question' to create one, or pick one from the list."
                               Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Center"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>

                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="DetailHeader" Text="Editing question" FontSize="18"
                                           FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Delete question" Style="{StaticResource DangerButton}"
                                        FontSize="13" Padding="12,6" Click="OnDeleteCurrent"/>
                            </Grid>

                            <TextBlock Text="QUESTION ID" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="IdBox" Style="{StaticResource FieldBox}" FontSize="16" Padding="10,8"
                                     Width="240" HorizontalAlignment="Left" LostFocus="OnFieldLostFocus"/>
                            <TextBlock Text="Unique, no spaces. Used internally, never shown to players."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18"/>

                            <TextBlock Text="QUESTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="QuestionBox" Style="{StaticResource FieldBox}" FontSize="17" Padding="10,8"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,18" LostFocus="OnFieldLostFocus"/>

                            <TextBlock Text="OPTIONS (select the radio button next to the correct one)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="A" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                <TextBox x:Name="OptionABox" Grid.Column="1" Style="{StaticResource FieldBox}" FontSize="15"
                                         Padding="10,8" Margin="0,0,12,0" LostFocus="OnFieldLostFocus"/>
                                <RadioButton x:Name="CorrectARadio" Grid.Column="2" GroupName="CorrectOption" Content="Correct"
                                             FontSize="13" VerticalAlignment="Center" Checked="OnCorrectChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="B" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                <TextBox x:Name="OptionBBox" Grid.Column="1" Style="{StaticResource FieldBox}" FontSize="15"
                                         Padding="10,8" Margin="0,0,12,0" LostFocus="OnFieldLostFocus"/>
                                <RadioButton x:Name="CorrectBRadio" Grid.Column="2" GroupName="CorrectOption" Content="Correct"
                                             FontSize="13" VerticalAlignment="Center" Checked="OnCorrectChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="C" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                <TextBox x:Name="OptionCBox" Grid.Column="1" Style="{StaticResource FieldBox}" FontSize="15"
                                         Padding="10,8" Margin="0,0,12,0" LostFocus="OnFieldLostFocus"/>
                                <RadioButton x:Name="CorrectCRadio" Grid.Column="2" GroupName="CorrectOption" Content="Correct"
                                             FontSize="13" VerticalAlignment="Center" Checked="OnCorrectChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="D" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                <TextBox x:Name="OptionDBox" Grid.Column="1" Style="{StaticResource FieldBox}" FontSize="15"
                                         Padding="10,8" Margin="0,0,12,0" LostFocus="OnFieldLostFocus"/>
                                <RadioButton x:Name="CorrectDRadio" Grid.Column="2" GroupName="CorrectOption" Content="Correct"
                                             FontSize="13" VerticalAlignment="Center" Checked="OnCorrectChanged"/>
                            </Grid>

                            <TextBlock Text="DIFFICULTY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <RadioButton x:Name="EasyRadio" GroupName="QuizDifficulty" Content="Easy" FontSize="14"
                                             VerticalAlignment="Center" Margin="0,0,18,0" Checked="OnDifficultyChanged"/>
                                <RadioButton x:Name="MediumRadio" GroupName="QuizDifficulty" Content="Medium" FontSize="14"
                                             VerticalAlignment="Center" Margin="0,0,18,0" Checked="OnDifficultyChanged"/>
                                <RadioButton x:Name="TrickyRadio" GroupName="QuizDifficulty" Content="Tricky" FontSize="14"
                                             VerticalAlignment="Center" Checked="OnDifficultyChanged"/>
                            </StackPanel>

                            <TextBlock Text="EXPLANATION (shown after the player answers)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ExplanationBox" Style="{StaticResource FieldBox}" FontSize="15" Padding="10,8"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                                     VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="18,8" Margin="4" Click="OnSave"/>
            <Button Content="Cancel" FontSize="15" Padding="16,8" Margin="4" Click="OnCancel"/>
        </WrapPanel>
    </Grid>
</Window>
