<Window x:Class="DataSortingGame.Views.QuizQuestionsEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage quiz questions" Width="1280" Height="720" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Manage quiz questions" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Correct = which option (1-4) is right. Difficulty: 1 easy, 2 medium, 3 tricky."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="20,0,0,6"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10,0,0"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                  Background="White" Foreground="#0F172A" RowBackground="White" AlternatingRowBackground="#F1F5F9"
                  HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0" FontSize="13" RowHeight="30"
                  ColumnHeaderHeight="32" AutomationProperties.Name="Quiz questions">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#BAE6FD"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="Question" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                <DataGridTextColumn Header="Option A" Binding="{Binding Options[0], UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="Option B" Binding="{Binding Options[1], UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="Option C" Binding="{Binding Options[2], UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="Option D" Binding="{Binding Options[3], UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridComboBoxColumn x:Name="CorrectColumn" Header="Correct"
                                         SelectedItemBinding="{Binding CorrectOption, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridComboBoxColumn x:Name="DifficultyColumn" Header="Difficulty"
                                         SelectedItemBinding="{Binding Difficulty, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Add question" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="18,8" Margin="4" Click="OnAddQuestion"/>
            <Button Content="Delete selected" FontSize="15" Padding="16,8" Margin="4" Click="OnDeleteSelected"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="18,8" Margin="4" Click="OnSave"/>
            <Button Content="Cancel" FontSize="15" Padding="16,8" Margin="4" Click="OnCancel"/>
        </WrapPanel>
    </Grid>
</Window>
