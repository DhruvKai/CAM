<UserControl x:Class="DataSortingGame.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <Grid Margin="60,30,60,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock x:Name="Headline" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="SubLine" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <UniformGrid x:Name="Tiles" Grid.Row="1" Rows="1" Margin="0,20,0,0"/>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ReviewHeader" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="ReviewList" Margin="0,0,10,0"/>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="Leaderboard" Width="190" Click="OnLeaderboard"/>
                <Button x:Name="DoneButton" Content="Done" Style="{StaticResource PrimaryButton}" Width="190" Margin="16,0,0,0" Click="OnDone"/>
            </StackPanel>
        </Grid>

        <Canvas x:Name="Confetti" IsHitTestVisible="False" ClipToBounds="True"/>
    </Grid>
</UserControl>
