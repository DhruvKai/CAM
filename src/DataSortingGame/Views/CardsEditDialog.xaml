<Window x:Class="DataSortingGame.Views.CardsEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage cards" Width="1200" Height="780" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Manage cards" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Pick a card on the left, then edit it on the right. Click Save when you're done."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card list -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="SEARCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" FontSize="14" Padding="10,8"
                                 TextChanged="OnSearchChanged" AutomationProperties.Name="Search cards"/>
                    </StackPanel>

                    <ListBox x:Name="CardList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectCard" AutomationProperties.Name="Card list">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#0F172A" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#243449"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,2,8,0"
                                                Background="{Binding ColorBrush}" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="18,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="+ Add card" Style="{StaticResource PrimaryButton}" FontSize="14"
                            Padding="14,8" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="OnAddCard"/>
                </Grid>
            </Border>

            <!-- Detail editor -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText"
                               Text="No card selected. Click '+ Add card' to create one, or pick one from the list."
                               Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Center"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>

                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="DetailHeader" Text="Editing card" FontSize="20"
                                           FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Delete card" Style="{StaticResource DangerButton}"
                                        FontSize="13" Padding="12,6" Click="OnDeleteCurrent"/>
                            </Grid>

                            <TextBlock Text="CARD ID" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="IdBox" Style="{StaticResource FieldBox}" FontSize="16" Padding="10,8"
                                     Width="240" HorizontalAlignment="Left" LostFocus="OnFieldLostFocus"/>
                            <TextBlock Text="Unique, no spaces. Used internally, never shown to players."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18"/>

                            <TextBlock Text="LABEL (shown on the card)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="LabelBox" Style="{StaticResource FieldBox}" FontSize="18" Padding="10,8"
                                     Margin="0,0,0,18" LostFocus="OnFieldLostFocus"/>

                            <TextBlock Text="EXAMPLE (fake sample value shown under the label)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ExampleBox" Style="{StaticResource FieldBox}" FontSize="15" Padding="10,8"
                                     Margin="0,0,0,18" LostFocus="OnFieldLostFocus"/>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CategoryCombo" FontSize="15" Padding="10,8" Height="40"
                                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnCategoryChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DIFFICULTY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="40">
                                        <RadioButton x:Name="EasyRadio" GroupName="CardDifficulty" Content="Easy" FontSize="14"
                                                     VerticalAlignment="Center" Margin="0,0,18,0" Checked="OnDifficultyChanged"/>
                                        <RadioButton x:Name="MediumRadio" GroupName="CardDifficulty" Content="Medium" FontSize="14"
                                                     VerticalAlignment="Center" Margin="0,0,18,0" Checked="OnDifficultyChanged"/>
                                        <RadioButton x:Name="TrickyRadio" GroupName="CardDifficulty" Content="Tricky" FontSize="14"
                                                     VerticalAlignment="Center" Checked="OnDifficultyChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="EXPLANATION (shown after the player answers)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ExplanationBox" Style="{StaticResource FieldBox}" FontSize="15" Padding="10,8"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="150"
                                     VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="18,8" Margin="4" Click="OnSave"/>
            <Button Content="Cancel" FontSize="15" Padding="16,8" Margin="4" Click="OnCancel"/>
        </WrapPanel>
    </Grid>
</Window>
