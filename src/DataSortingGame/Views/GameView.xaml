<UserControl x:Class="DataSortingGame.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="OnKeyDown">
    <Grid Margin="40,20,40,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PlayerText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                <Border x:Name="PracticeTag" Background="{StaticResource WarnBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="PRACTICE" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                </Border>
                <Button Content="End round" FontSize="13" Padding="12,4" Margin="14,0,0,0" Click="OnQuit" Opacity="0.7"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock x:Name="ProgressText" FontSize="18" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar" Width="340" Height="8" Margin="0,6,0,0" Minimum="0"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelBrush}" BorderThickness="0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ScoreText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="StreakText" FontSize="14" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="TimerBar" Grid.Row="1" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="100"
                     Foreground="{StaticResource WarnBrush}" Background="{StaticResource PanelBrush}" BorderThickness="0"
                     Visibility="Hidden"/>

        <!-- Card + feedback -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Border x:Name="CardBorder" Width="580" MinHeight="200" Background="White" CornerRadius="20" Padding="30,26"
                    Cursor="SizeAll" RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonDown="OnCardMouseDown" MouseMove="OnCardMouseMove">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CardLabel" FontSize="34" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Center"/>
                    <TextBlock x:Name="CardExample" FontSize="18" FontStyle="Italic" Foreground="#475569" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="DragHint" Text="Drag the card into a box, click a box, or press its number key"
                       FontSize="16" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" Height="60"/>

            <Border x:Name="FeedbackPanel" Visibility="Collapsed" Width="920" Margin="0,14,0,0" Padding="20,12"
                    Background="{StaticResource PanelBrush}" CornerRadius="14" BorderThickness="3" MinHeight="60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FeedbackTitle" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="FeedbackBody" FontSize="16" Margin="0,4,0,0" Foreground="#CBD5E1"/>
                    </StackPanel>
                    <Button x:Name="NextButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" FontSize="18" Padding="24,10"
                            Margin="24,0,0,0" VerticalAlignment="Center" Click="OnNext"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Category boxes -->
        <UniformGrid x:Name="Boxes" Grid.Row="3" Rows="1" Height="196" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
