<UserControl x:Class="DataSortingGame.Views.QuizLeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="70,28,70,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Quiz leaderboard" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="16,18,26,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rank" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
            <TextBlock Grid.Column="1" Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
            <TextBlock Grid.Column="2" Text="Employee code" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
            <TextBlock Grid.Column="3" Text="Correct" Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="Time" Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="Score" Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBrush}" CornerRadius="10" Padding="16,9" Margin="0,0,10,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Rank}" Foreground="{Binding RankBrush}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EmployeeCode}" FontSize="18" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Correct}" FontSize="18" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="18" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Score}" FontSize="24" FontWeight="Bold" TextAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="No scores yet. Be the first to play the quiz!" FontSize="22"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,60,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="BackButton" Grid.Row="3" Content="Back" Style="{StaticResource PrimaryButton}" Width="200" Margin="0,14,0,0" Click="OnBack"/>
    </Grid>
</UserControl>
