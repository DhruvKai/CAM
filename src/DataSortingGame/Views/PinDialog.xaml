<Window x:Class="DataSortingGame.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin" Width="380" Height="230" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Enter the admin PIN" FontSize="18" FontWeight="SemiBold"/>
        <PasswordBox x:Name="PinBox" FontSize="20" Padding="10,8" Margin="0,12,0,0" MaxLength="32"
                     AutomationProperties.Name="Admin PIN" KeyDown="OnKeyDown"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" FontSize="14" Margin="0,8,0,0" Height="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" IsCancel="True" FontSize="15" Padding="18,7"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="26,7" Margin="10,0,0,0" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
