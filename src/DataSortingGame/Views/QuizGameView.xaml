<UserControl x:Class="DataSortingGame.Views.QuizGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="OnKeyDown">
    <Grid Margin="40,20,40,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PlayerText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                <Border x:Name="PracticeTag" Background="{StaticResource WarnBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="PRACTICE" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                </Border>
                <Button Content="End quiz" FontSize="13" Padding="12,4" Margin="14,0,0,0" Click="OnQuit" Opacity="0.7"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock x:Name="ProgressText" FontSize="18" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar" Width="340" Height="8" Margin="0,6,0,0" Minimum="0"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelBrush}" BorderThickness="0"/>
            </StackPanel>

            <StackPanel x:Name="ScorePanel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ScoreText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="StreakText" FontSize="14" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Difficulty picker: always visible, enabled only between questions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock Text="Next question:" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border x:Name="EasyWrap" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Padding="2" Margin="4,0">
                <Button x:Name="EasyButton" Content="Easy" Tag="1" Width="106" FontSize="15" Padding="10,7"
                        Background="#22C55E" Foreground="#0F172A" Click="OnPickDifficulty"/>
            </Border>
            <Border x:Name="MediumWrap" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Padding="2" Margin="4,0">
                <Button x:Name="MediumButton" Content="Medium" Tag="2" Width="106" FontSize="15" Padding="10,7"
                        Background="#F5C542" Foreground="#0F172A" Click="OnPickDifficulty"/>
            </Border>
            <Border x:Name="TrickyWrap" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Padding="2" Margin="4,0">
                <Button x:Name="TrickyButton" Content="Tricky" Tag="3" Width="106" FontSize="15" Padding="10,7"
                        Background="#EF4444" Foreground="White" Click="OnPickDifficulty"/>
            </Border>
        </StackPanel>

        <ProgressBar x:Name="TimerBar" Grid.Row="2" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="100"
                     Foreground="{StaticResource WarnBrush}" Background="{StaticResource PanelBrush}" BorderThickness="0"/>

        <!-- Question + options + feedback -->
        <StackPanel Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Border Width="820" MinHeight="120" Background="White" CornerRadius="20" Padding="30,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <TextBlock x:Name="QuestionText" FontSize="26" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>

            <UniformGrid x:Name="Options" Columns="2" Rows="2" Width="820" Margin="0,16,0,0">
                <Button x:Name="Option0" Tag="0" FontSize="17" Padding="16,14" Margin="6" Click="OnOptionClick" HorizontalContentAlignment="Left"/>
                <Button x:Name="Option1" Tag="1" FontSize="17" Padding="16,14" Margin="6" Click="OnOptionClick" HorizontalContentAlignment="Left"/>
                <Button x:Name="Option2" Tag="2" FontSize="17" Padding="16,14" Margin="6" Click="OnOptionClick" HorizontalContentAlignment="Left"/>
                <Button x:Name="Option3" Tag="3" FontSize="17" Padding="16,14" Margin="6" Click="OnOptionClick" HorizontalContentAlignment="Left"/>
            </UniformGrid>

            <Button x:Name="RevealButton" Content="Reveal answer" Style="{StaticResource PrimaryButton}" FontSize="18"
                    Padding="26,10" Margin="0,16,0,0" Click="OnReveal" Visibility="Collapsed"/>

            <Border x:Name="FeedbackPanel" Visibility="Collapsed" Width="820" Margin="0,16,0,0" Padding="20,12"
                    Background="{StaticResource PanelBrush}" CornerRadius="14" BorderThickness="3" MinHeight="60">
                <StackPanel>
                    <TextBlock x:Name="FeedbackTitle" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="FeedbackBody" FontSize="16" Margin="0,4,0,0" Foreground="#CBD5E1"/>
                </StackPanel>
            </Border>

            <Button x:Name="FinishButton" Content="See results" Style="{StaticResource PrimaryButton}" FontSize="18"
                    Padding="26,10" Margin="0,16,0,0" Click="OnFinish" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
