<UserControl x:Class="DataSortingGame.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,24,40,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Admin" FontSize="34" FontWeight="Bold"/>
            <TextBlock x:Name="Summary" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="20,0,0,6"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                      Background="White" Foreground="#0F172A" RowBackground="White" AlternatingRowBackground="#F1F5F9"
                      HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0" FontSize="14" RowHeight="30"
                      ColumnHeaderHeight="32" AutomationProperties.Name="All results">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E2E8F0"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <!-- The app-wide TextBlock style is white; the header needs explicit dark text. -->
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#BAE6FD"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Employee code" Binding="{Binding EmployeeCode}" Width="110"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>
                    <DataGridTextColumn Header="Counts" Binding="{Binding Counts}" Width="75"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60"/>
                    <DataGridTextColumn Header="Correct" Binding="{Binding Correct}" Width="70"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70"/>
                    <DataGridTextColumn Header="Played" Binding="{Binding Played}" Width="135"/>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Most missed cards" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MissedText" FontSize="13.5" Foreground="#CBD5E1" Margin="0,4,0,16"/>

                    <TextBlock Text="Settings warnings" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WarningText" FontSize="13.5" Foreground="{StaticResource WarnBrush}" Margin="0,4,0,16"/>

                    <TextBlock Text="Game settings" FontSize="17" FontWeight="SemiBold"/>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cards per round" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CardsPerRoundBox" Style="{StaticResource FieldBox}" FontSize="15" Padding="10,5" Width="65"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Seconds per card (0 = off)" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="SecondsPerCardBox" Style="{StaticResource FieldBox}" FontSize="15" Padding="10,5" Width="65"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Save game settings" FontSize="13.5" Padding="14,5" Margin="0,8,0,4" HorizontalAlignment="Left" Click="OnSaveGameSettings"/>
                    <TextBlock Text="Applies to the next round." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16"/>

                    <TextBlock Text="Quiz settings" FontSize="17" FontWeight="SemiBold"/>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Questions per round" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="QuestionsPerRoundBox" Style="{StaticResource FieldBox}" FontSize="15" Padding="10,5" Width="65"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Seconds per question" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="SecondsPerQuestionBox" Style="{StaticResource FieldBox}" FontSize="15" Padding="10,5" Width="65"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Save quiz settings" FontSize="13.5" Padding="14,5" Margin="0,8,0,4" HorizontalAlignment="Left" Click="OnSaveQuizSettings"/>
                    <TextBlock Text="The quiz timer is mandatory and can't be turned off (minimum 5s)." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16"/>

                    <TextBlock Text="Files" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PathText" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Center">
            <Button Content="Export CSV" Style="{StaticResource PrimaryButton}" FontSize="16" Padding="20,9" Margin="4" Click="OnExport"/>
            <Button Content="Delete selected" FontSize="16" Padding="18,9" Margin="4" Click="OnDeleteSelected"/>
            <Button Content="Clear all results" Style="{StaticResource DangerButton}" FontSize="16" Padding="18,9" Margin="4" Click="OnClearAll"/>
            <Button Content="Manage cards" FontSize="16" Padding="18,9" Margin="4" Click="OnManageCards"/>
            <Button Content="Manage quiz questions" FontSize="16" Padding="18,9" Margin="4" Click="OnManageQuizQuestions"/>
            <Button Content="Reload settings" FontSize="16" Padding="18,9" Margin="4" Click="OnReload"/>
            <Button Content="Open settings folder" FontSize="16" Padding="18,9" Margin="4" Click="OnOpenFolder"/>
            <Button Content="Back" FontSize="16" Padding="18,9" Margin="4" Click="OnBack"/>
            <Button Content="Exit app" Style="{StaticResource DangerButton}" FontSize="16" Padding="18,9" Margin="4" Click="OnExit"/>
        </WrapPanel>
    </Grid>
</UserControl>
