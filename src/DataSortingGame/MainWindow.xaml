<Window x:Class="DataSortingGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Sorting Game" Width="1280" Height="720" MinWidth="800" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Every screen is laid out on a fixed 1280x720 canvas that scales to any display. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1280" Height="720">
            <ContentControl x:Name="Host" IsTabStop="False"/>
        </Grid>
    </Viewbox>
</Window>
